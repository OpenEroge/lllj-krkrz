// TextRenderBase behaviour probe. Runs unchanged in the original game (Windows
// textrender.dll, injected under Wine by tools/textrender_compare.py) and in this
// port (over the REPL), and logs every character's position and delay, the key
// waits and the render bounds for the same inputs into System.dataPath + "tr_log.txt".
class LLLJTextRenderProbe
{
	var timer;
	var log = [];
	var phase = 0;
	var since = 0;
	var lastClick = 0;

	function LLLJTextRenderProbe()
	{
		timer = new Timer(onTimer, "");
		timer.interval = 500;
		timer.enabled = true;
	}

	function note(text)
	{
		log.add(text);
		log.save(System.dataPath + "tr_log.txt");
	}

	function onTimer()
	{
		try {
			step();
		} catch (e) {
			note("error in phase " + phase + ": " + e.message);
			timer.enabled = false;
			note("done");
		}
	}

	function next() { phase++; since = System.getTickCount(); }
	function elapsed() { return System.getTickCount() - since; }

	// unit cases first, then the game's own backlog renderer
	function step()
	{
		switch (phase) {
		case 0:
			if (typeof global.kag != "Object" || typeof global.TextRender != "Object") return;
			try { run(); } catch (e) { note("error: " + e.message); }
			next();
			break;
		case 1: // title (caution and logos accept clicks)
			if (typeof global.SystemHook != "Object") return;
			if (SystemHook.currentState != "title" || !kag.inStable) {
				if (System.getTickCount() - lastClick > 2000) { lastClick = System.getTickCount(); kag.onPrimaryClick(); }
				return guard();
			}
			if (elapsed() < 2000) return;
			kag.process("title.ks", "*game");
			next();
			break;
		case 2: // three lines in, so the backlog has entries
			if (typeof global.world_object != "Object" || typeof world_object.player != "Object" ||
				world_object.player.curPoint <= 0) return guard();
			if (world_object.player.cur < 3) {
				if (System.getTickCount() - lastClick < 700 || !kag.inStable) return guard();
				lastClick = System.getTickCount();
				kag.onPrimaryClick();
				return guard();
			}
			if (elapsed() < 1000 || !kag.inStable) return guard();
			hookBacklog();
			SystemAction.backlog();
			next();
			break;
		case 3:
			if (SystemHook.currentState != "backlog" || elapsed() < 2000) return guard();
			try { backlog(); } catch (e) { note("error in backlog: " + e.message); }
			timer.enabled = false;
			note("done");
			break;
		}
	}

	function guard()
	{
		if (elapsed() > 60000) { note("timeout in phase " + phase); timer.enabled = false; note("done"); }
	}

	// log the arguments of the backlog's text renders and where the first
	// characters land (both paths: _tryRenderText and TextRender.draw)
	function chars(r)
	{
		var cs = r.getCharacters(0, 0);
		var s = "n=" + cs.count + " top=" + (int)r.renderTop + " bot=" + (int)r.renderBottom + " over=" + (int)r.renderOver + " |";
		for (var i = 0; i < cs.count && i < 4; i++) s += " " + cs[i].text + "@" + (int)cs[i].y + "/" + (int)cs[i].size;
		return s;
	}

	// log the arguments of the backlog's text renders (the originals are kept on
	// this object: TJS closures do not capture locals)
	var origTry;
	var origRender;

	function hookBacklog()
	{
		origTry = CustomBacklog._tryRenderText;
		CustomBacklog._tryRenderText = function(layer, dy, text) {
			var p = global.llljTextRenderProbe;
			p.note("hook _tryRenderText dy=" + dy + " textTop=" + this.textTop + " text=" + text);
			var ret = (p.origTry incontextof this)(layer, dy, text);
			p.note("hook   -> " + p.chars(this._render));
			return ret;
		};
		origRender = TextRender.render;
		TextRender.render = function(w, h, font, text, indent, base, a, b, c) {
			var p = global.llljTextRenderProbe;
			p.note("hook TextRender.render " + w + "x" + h + " indent=" + indent + " text=" + text);
			var ret = (p.origRender incontextof this)(w, h, font, text, indent, base, a, b, c);
			p.note("hook   -> " + p.chars(this));
			return ret;
		};
	}

	function backlog()
	{
		var b = Dialog._object;
		var t = %[ ox: b.textLeft, oy: b.textTop, w: b.textWidth, h: b.textHeight ];
		var r = b._render;
		note("backlog text box " + (int)t.ox + "," + (int)t.oy + " " + (int)t.w + "x" + (int)t.h +
			" fontSize=" + (int)r.defaultFontSize + " lineSpacing=" + (int)r.defaultLineSpacing +
			" valign=" + r.defaultValign + " face=" + r.defaultFace + " autoIndent=" + b.renderAutoIndent);
		var texts = [ "%n;abc", "abc", "abc%n;def", "%n2;abc", "\\nabc", "%n;%n;abc" ];
		for (var i = 0; i < texts.count; i++) {
			r.setRenderSize(t.w, t.h);
			r.clear();
			(global.TextRenderBase.render incontextof r)(texts[i], -1, 0, 0, 0, 0);
			r.done();
			dump("backlog " + texts[i], r);
		}

		// a fresh TextRender with the backlog's face and size: is it the font?
		var f = new TextRender();
		f.defaultFontSize = r.defaultFontSize;
		f.defaultLineSpacing = r.defaultLineSpacing;
		f.defaultFace = r.defaultFace;
		f.setRenderSize(t.w, t.h);
		for (var i = 0; i < texts.count; i++) {
			f.clear();
			(global.TextRenderBase.render incontextof f)(texts[i], -1, 0, 0, 0, 0);
			f.done();
			dump("fresh " + r.defaultFace + " " + texts[i], f);
		}
		f.defaultFace = "normal";
		for (var i = 0; i < 2; i++) {
			f.clear();
			(global.TextRenderBase.render incontextof f)(texts[i], -1, 0, 0, 0, 0);
			f.done();
			dump("fresh normal " + texts[i], f);
		}
		invalidate f;
	}

	function dump(name, r)
	{
		var cs = r.getCharacters(0, 0);
		var s = name + " | n=" + cs.count + " top=" + (int)r.renderTop + " bot=" + (int)r.renderBottom +
			" left=" + (int)r.renderLeft + " right=" + (int)r.renderRight + " over=" + (int)r.renderOver +
			" delay=" + (int)r.renderDelay + " |";
		for (var i = 0; i < cs.count; i++) {
			var c = cs[i];
			s += " " + c.text + "@" + (int)c.x + "," + (int)c.y + ":" + (int)c.delay;
		}
		var kw = r.getKeyWait();
		s += " | kw";
		for (var i = 0; i < kw.count; i++) s += " " + kw[i].pos + "/" + (int)kw[i].time;
		note(s);
	}

	function render(r, text, indent, diff, same)
	{
		(global.TextRenderBase.render incontextof r)(text, indent, diff, 0, same, 0);
	}

	function run()
	{
		var r = new TextRender();
		r.defaultFontSize = 30;
		r.defaultLineSpacing = 10;
		r.setRenderSize(600, 200);
		note("ascent probe: defaultFace=" + r.defaultFace);

		// [text, autoIndent, diff]
		var cases = [
			[ "abc", 0, 0 ],
			[ "%n;abc", -1, 0 ],
			[ "%n;abc", 0, 0 ],
			[ "%n;abc", 1, 0 ],
			[ "abc%n;def", 0, 0 ],
			[ "abc%n1;def", 0, 0 ],
			[ "abc%n2;def", 0, 0 ],
			[ "%n2;abc", 0, 0 ],
			[ "abc\\ndef", 0, 0 ],
			[ "abc%n;", 0, 0 ],
			[ "abcdef", 0, 25 ],
			[ "abc%d200;def", 0, 25 ],
			[ "abc%w100;def", 0, 25 ],
			[ "abc\\kdef", 0, 25 ],
			[ "「abc」def", 1, 0 ],
			[ "あいうえおかきくけこさしすせそたちつてとなにぬねのはひふへほまみむめもやゆよらりるれろわをん", 0, 0 ]
		]; // no trailing comma: TJS would add a void element
		for (var i = 0; i < cases.count; i++) {
			var c = cases[i];
			try {
				r.clear();
				render(r, c[0], c[1], c[2], 0);
				r.done();
				dump("case " + c[0] + " ai=" + c[1] + " diff=" + c[2], r);
			} catch (e) {
				note("error in case " + c[0] + ": " + e.message);
			}
		}

		try { sequence(r); } catch (e) { note("error in sequence: " + e.message); }
		try { valign(r); } catch (e) { note("error in valign: " + e.message); }
		invalidate r;
	}

	function sequence(r)
	{
		// message window: sentences appended without clear
		r.clear();
		render(r, "%n;abc", 1, 25, 0);
		r.done();
		dump("seq1 %n;abc", r);
		render(r, "%n;def", 1, 25, 0);
		r.done();
		dump("seq2 +%n;def", r);
		render(r, "ghi", 1, 25, 1);
		r.done();
		dump("seq3 +ghi same", r);
		r.clear();
		render(r, "abc", 0, 0, 0);
		r.done();
		render(r, "def", 0, 0, 0);
		r.done();
		dump("seq4 abc then def", r);
		r.clear();
		render(r, "abc\\n", 0, 0, 0);
		r.done();
		render(r, "def", 0, 0, 0);
		r.done();
		dump("seq5 abc\\n then def", r);
	}

	function valign(r)
	{
		// valign centre and bottom, one line
		r.clear();
		r.setDefault(%[ valign: 0 ]);
		r.clear();
		render(r, "abc", 0, 0, 0);
		r.done();
		dump("valign0 abc", r);
		r.setDefault(%[ valign: 1 ]);
		r.clear();
		render(r, "abc", 0, 0, 0);
		r.done();
		dump("valign1 abc", r);
		r.setDefault(%[ valign: -1 ]);
	}
}
global.llljTextRenderProbe = new LLLJTextRenderProbe();
