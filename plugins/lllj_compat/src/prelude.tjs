// Minimal MenuItem replacement (no native menus on this platform)
class MenuItem {
	var children = [];
	var parent;
	var caption = "";
	var checked = false;
	var enabled = true;
	var visible = true;
	var group = 0;
	var radio = false;
	var shortcut = "";
	var rightJustify = false;
	var bmpItem = 0;
	var bmpChecked = 0;
	var bmpUnchecked = 0;
	var index = 0;
	var owner;
	function MenuItem(owner, caption) { this.owner = owner; if (caption !== void) this.caption = caption; }
	function finalize() {}
	function add(item) { item.parent = this; item.index = children.count; children.add(item); }
	function insert(item, idx) { item.parent = this; children.insert(idx, item); }
	function remove(item) { children.remove(item); }
	function popup() {}
	function popupEx() { return 0; }
	property root { getter() { return parent === void ? this : parent.root; } }
	property HMENU { getter() { return 0; } }
	property window { getter() { return owner; } }
}
// MenuItemEx (windowEx) bitmap ids
{
	var c = ["biSystem", 1, "biRestore", 2, "biMinimize", 3, "biClose", 5, "biCloseDisabled", 6,
		"biMinimizeDisabled", 7, "biPopupClose", 8, "biPopupRestore", 9, "biPopupMaximize", 10, "biPopupMinimize", 11];
	for (var i = 0; i < c.count; i += 2) MenuItem[c[i]] = c[i+1];
}

// gamepad.dll: the game's legacy XInput layer (exgamepad.tjs) is not emulated. With
// "-joypad=dinput" the game skips gamepad.dll and uses the engine's own pad input, as the
// original does on DirectInput: krkrz's SDL gamepad support sends VK_PAD* keys, which KAG
// maps through padKeyMap (krkrz_dev/src/core/doc/Gamepad.md). An explicit -joypad wins.
if (System.getArgument("-joypad") === void) System.setArgument("-joypad", "dinput");
