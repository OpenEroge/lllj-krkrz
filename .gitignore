# build output (./build.sh)
/build/
# reference sources (re-cloneable, read-only)
/ref/
# run directory: symlinks into the game's result/ + generated archives (games/lllj/setup.sh)
/game/
# disassembled / decrypted game scripts (tools/formats/tjsdis.py, fefe.py)
/decomp/
# prebuilt FFmpeg (tools/fetch_ffmpeg.sh)
/third_party/
# test output (games/*/tests)
/artifacts/
# runtime / test leftovers
/.replch/
/tmp/
*.log
__pycache__/
