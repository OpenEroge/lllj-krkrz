+#if !defined(_WIN32)
+// ---------------------------------------------------------------------------
+// LLLJ: case-insensitive path fallback for case-sensitive file systems.
+// Game scripts written for Windows refer to e.g. "system/Initialize.tjs"
+// while the file on disk is "system/initialize.tjs". When the exact path does
+// not exist, each path component is matched case-insensitively (ASCII fold).
+// ---------------------------------------------------------------------------
+#include <dirent.h>
+#include <strings.h>
+#include <sys/stat.h>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+static std::mutex TVPCaseDirMutex;
+static std::unordered_map<std::string, std::vector<std::string>> TVPCaseDirCache;
+
+static bool TVPFindCaseEntry(const std::string &dir, const std::string &name, std::string &found)
+{
+	std::lock_guard<std::mutex> lock(TVPCaseDirMutex);
+	auto it = TVPCaseDirCache.find(dir);
+	if (it == TVPCaseDirCache.end()) {
+		std::vector<std::string> entries;
+		if (DIR *d = opendir(dir.empty() ? "/" : dir.c_str())) {
+			while (struct dirent *e = readdir(d)) entries.emplace_back(e->d_name);
+			closedir(d);
+		}
+		it = TVPCaseDirCache.emplace(dir, std::move(entries)).first;
+	}
+	for (auto &e : it->second) {
+		if (e.size() == name.size() && strcasecmp(e.c_str(), name.c_str()) == 0) { found = e; return true; }
+	}
+	return false;
+}
+
+// Returns true if path (absolute, UTF-8) was rewritten to an existing path.
+static bool TVPResolvePathCase(std::string &path)
+{
+	struct stat st;
+	if (path.empty() || path[0] != '/' || ::stat(path.c_str(), &st) == 0) return false;
+	std::string result;
+	size_t pos = 1;
+	bool trailing = path.back() == '/';
+	while (pos <= path.size()) {
+		size_t next = path.find('/', pos);
+		if (next == std::string::npos) next = path.size();
+		std::string comp = path.substr(pos, next - pos);
+		pos = next + 1;
+		if (comp.empty()) continue;
+		std::string cand = result + "/" + comp;
+		if (::stat(cand.c_str(), &st) != 0) {
+			std::string real;
+			if (!TVPFindCaseEntry(result, comp, real)) return false;
+			cand = result + "/" + real;
+		}
+		result = cand;
+	}
+	if (trailing) result += '/';
+	path = result;
+	return true;
+}
+#else
+static bool TVPResolvePathCase(std::string &) { return false; }
+#endif
